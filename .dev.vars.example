# Local Worker configuration for `npm run worker:dev` (http://localhost:8787).
# Copy to .dev.vars and fill in the Resend values if you want real emails.
# Never commit .dev.vars and never put production secrets in it.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100
PUBLIC_API_URL=http://localhost:8787
# Must be on one of ALLOWED_ORIGINS; `?subscription=confirmed` is appended.
SUBSCRIPTION_CONFIRMATION_REDIRECT_URL=http://localhost:3000/
ORGANIZATION_NAME=Tzion Breslov

# Cloudflare's documented always-pass test secret; never use it in production.
# Pair it with the always-pass test site key 1x00000000000000000000AA in the frontend.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

RESEND_TRANSACTIONAL_API_KEY=re_replace_me
RESEND_CONTACTS_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Tzion Breslov <no-reply@example.com>
# Production value is tzionbreslovproject@gmail.com (installed as a Worker secret).
CONTACT_TO_EMAIL=you@example.com
RESEND_NEWSLETTER_TOPIC_ID=replace-me

RESEND_WEBHOOK_SECRET=replace-me
