# Local Worker configuration for `npm run worker:dev` (http://localhost:8787).
# Copy to .dev.vars and fill in the Resend values if you want real emails.
# Never commit .dev.vars and never put production secrets in it.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100
PUBLIC_API_URL=http://localhost:8787
# Must be on one of ALLOWED_ORIGINS; the emailed link 303s here with `?subscription=…`
# appended (confirm#token=…, confirmed, invalid or error; see lib/api-contract.ts).
SUBSCRIPTION_CONFIRMATION_REDIRECT_URL=http://localhost:3000/
ORGANIZATION_NAME=Tzion Breslov

# Cloudflare's documented always-pass test secret; never use it in production.
# Pair it with the always-pass test site key 1x00000000000000000000AA in the frontend.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

RESEND_TRANSACTIONAL_API_KEY=re_replace_me
RESEND_CONTACTS_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Tzion Breslov <no-reply@example.com>
# Optional Reply-To for the subscription confirmation email (production value is in wrangler.jsonc vars).
RESEND_REPLY_TO_EMAIL=you@example.com
# Production value is tzionbreslovproject@gmail.com (installed as a Worker secret).
CONTACT_TO_EMAIL=you@example.com
RESEND_NEWSLETTER_TOPIC_ID=replace-me
# The "Event announcements" topic (scripts/setup-resend.mjs creates it).
RESEND_EVENTS_TOPIC_ID=replace-me

RESEND_WEBHOOK_SECRET=replace-me

# The phone number POST /v1/contact-details answers ("Show number"), in E.164: + then 1 and 10 digits.
# Keep this fake one locally; the real number is only ever a Worker secret (README → Switch day, step 3).
# PUBLIC_CONTACT_EMAIL, the email it answers, comes from wrangler.jsonc's vars.
CONTACT_PHONE=+15555550123

# RSVPs: the events the Worker takes RSVPs for (the site's /events.json; locally the
# `node scripts/serve-out.mjs` copy of a build). The daily cleanup reads it too: it deletes an RSVP once
# its event is over, by the event's current end (while it can't be read, only once the stored end is 7 days past).
EVENTS_FEED_URL=http://localhost:3100/events.json
