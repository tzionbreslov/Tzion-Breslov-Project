{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tzion-breslov-api",
  // Tzion Breslov Cloudflare account (tzionbreslovproject@gmail.com). Not a secret.
  "account_id": "ecde4769aa54b9c021e26cd26be213fa",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.tzionbreslov.org",
      "custom_domain": true
    }
  ],
  // The site's permanent home is tzionbreslov.org (until the switch, .org redirects to
  // the WordPress site on tzionbreslov.com, and the forms stay disabled on the site).
  "vars": {
    "ALLOWED_ORIGINS": "https://tzionbreslov.org,https://www.tzionbreslov.org",
    "PUBLIC_API_URL": "https://api.tzionbreslov.org",
    "SUBSCRIPTION_CONFIRMATION_REDIRECT_URL": "https://tzionbreslov.org/",
    "ORGANIZATION_NAME": "Tzion Breslov",
    "TURNSTILE_EXPECTED_HOSTNAMES": "tzionbreslov.org,www.tzionbreslov.org",
    // Optional, not a secret: Reply-To on the subscription confirmation email. tzionbreslov.org
    // has no MX (by choice), so without it a subscriber's reply would sit deferred for days
    // before bouncing. Blank/absent = no Reply-To. Contact notifications reply to the visitor.
    "RESEND_REPLY_TO_EMAIL": "tzionbreslovproject@gmail.com",
    // The site's own list of upcoming events (scripts/write-site-files.mjs): which events take
    // RSVPs, when they start and end, and their limit. Fetched without following redirects, so until
    // switch day (.org still 302s to .com) RSVPs answer EVENTS_UNAVAILABLE.
    "EVENTS_FEED_URL": "https://tzionbreslov.org/events.json"
  },
  // Install each with `npx wrangler secret put NAME`. Values never live in this file.
  // TURNSTILE_SECRET_KEY belongs to the "Tzion Breslov forms" widget
  // (site key 0x4AAAAAAF1kfPJ0qES50FAh).
  "secrets": {
    "required": [
      "RATE_LIMIT_SALT",
      "TURNSTILE_SECRET_KEY",
      "RESEND_TRANSACTIONAL_API_KEY",
      "RESEND_CONTACTS_API_KEY",
      "RESEND_FROM_EMAIL",
      "CONTACT_TO_EMAIL",
      "RESEND_NEWSLETTER_TOPIC_ID",
      // The "Event announcements" topic (scripts/setup-resend.mjs); install before the next deploy.
      "RESEND_EVENTS_TOPIC_ID",
      "RESEND_WEBHOOK_SECRET"
    ]
  },
  // With invocation logs off, Workers Logs (dashboard → Workers & Pages → the Worker → Observability)
  // are expected to keep only the Worker's own log lines, for up to 7 days: RSVP_ORGANIZER_EMAIL_FAILED,
  // RSVP_CANCEL_FAILED, RSVP_CLEANUP_FEED_UNAVAILABLE, EVENTS_FEED_EVENT_SKIPPED and the error
  // lines (codes, method and path but never the query string, request or correlation ids; no
  // personal data), so they can be found later, not only in a live `wrangler tail`. Cloudflare's own
  // fields in a stored event are $-prefixed ($workers…, $metadata…); the Worker's are not. Cloudflare's
  // docs don't say whether a stored line still carries request fields (URL, headers, IP) with
  // invocation logs off, so this is confirmed on switch day (README → Switch day, step 4, the
  // log-probe check); if the check fails, "enabled" becomes false.
  // Invocation logs stay OFF: they would store every request's method + URL (e.g.
  // /v1/subscribe/confirm?token=…), headers and the visitor's IP. "redact_query_string" (Cloudflare:
  // "Whether query strings are removed from request URLs in logs and traces") is a second guard for
  // any URL Cloudflare does record, not a substitute for the check. Takes effect at deploy.
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  // Daily cleanup of rate-limit buckets, expired confirmations, old request logs, webhook rows, and the RSVPs of
  // events that are over: each RSVP first takes its event's current end from EVENTS_FEED_URL (an event moved in the
  // calendar keeps its RSVPs), then those whose end has passed are deleted. No RSVP is deleted on a day the feed
  // can't be read.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tzion-breslov-production",
      // Created 2026-11-06; 0001_initial.sql applied and recorded in d1_migrations.
      "database_id": "430c5c20-673d-4e3f-b186-18c8c00cbcd8",
      "migrations_dir": "worker/migrations"
    }
  ]
}
